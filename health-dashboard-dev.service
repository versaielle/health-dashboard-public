[Unit]
Description=Health Dashboard (Development)
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/health-dashboard-dev/server
EnvironmentFile=/opt/health-dashboard-dev/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
